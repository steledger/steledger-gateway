listen=1
server=1
daemon=0
emcdns=1
emcdnsport=5335
rpcallowip=0.0.0.0/0
rpcbind=0.0.0.0
rpcport=6662
maxconnections=80
reservebalance=0
rpcuser=emcrpc
rpcpassword=emcpass
nameaddress=1

# No PoS minting: this node only serves the gateway and the swap; minting
# earns nothing here and is a grey zone under hosting AUPs.
stakegen=0
# Do not advertise this host's public IP via addr gossip (peers are still
# found and used normally).
discover=0
